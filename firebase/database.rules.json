{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['firebase_uid']) && newData.child('firebase_uid').val() === $uid"
      }
    },
    "user_workspaces": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "workspaces": {
      "$workspace_id": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        ".write": false,
        "members": {
          "$uid": {
            ".read": "auth != null && data.parent().parent().child('members').child(auth.uid).exists()",
            ".write": false
          }
        },
        "subscription": {
          ".read": "auth != null && data.parent().parent().child('members').child(auth.uid).exists()",
          ".write": false
        }
      }
    }
  }
}
