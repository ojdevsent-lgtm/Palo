{
  "schema_version": 1,
  "currency": "NGN",
  "plans": {
    "free": { "max_members": 1, "price_ngn": 0, "billing_period": "none" },
    "team": { "max_members": 5, "price_ngn": 1200, "billing_period": "yearly" },
    "team_plus": { "max_members": 20, "price_ngn": 2500, "billing_period": "yearly" },
    "large_team": { "max_members": null, "price_ngn": 4500, "billing_period": "yearly" }
  },
  "rules": {
    "plan_changes_are_server_authoritative": true,
    "client_must_not_write_plan_id": true,
    "payment_must_be_verified_before_upgrade": true,
    "downgrade_must_not_remove_existing_members_automatically": true
  },
  "payment": {
    "provider": "pending_selection",
    "verification_endpoint": "trusted_backend",
    "webhook_secret": "never_store_in_repository"
  }
}
